# Normalise line endings: LF in the repo and working tree on every OS.
* text=auto eol=lf

# Binary assets
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary

# Keep release tarballs lean — exclude dev-only files from `composer require`.
/.github            export-ignore
/tests              export-ignore
/docs               export-ignore
/build.js           export-ignore
/package.json       export-ignore
/package-lock.json  export-ignore
/phpunit.xml.dist   export-ignore
/phpstan.neon.dist  export-ignore
/pint.json          export-ignore
/CLAUDE.md          export-ignore
/CONTRIBUTING.md    export-ignore
/SECURITY.md        export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/.editorconfig      export-ignore
/resources/js       export-ignore
/resources/css      export-ignore

*.blade.php diff=html
*.php       diff=php
